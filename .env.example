# Postgres (Railway provides DATABASE_URL automatically)
DATABASE_URL=postgres://localhost:5432/vitalo

# Signs app access tokens and protects admin two-factor secrets. Required in production:
#   openssl rand -base64 48
AUTH_SECRET=

# Public base URL of this server, used in absolute links (e.g. brand logo URLs)
PUBLIC_URL=http://localhost:3000

# Sign in with Apple and App Store (bundle ID of the iOS app)
APPLE_BUNDLE_ID=ch.vitalo.app
# For revoking Apple tokens on account deletion: key from developer.apple.com (Sign in with Apple)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Push notifications (APNs token key, .p8 contents with \n for line breaks)
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=ch.vitalo.app

# Claude for photo/text recognition, label reading and moderation. Without it AI answers "unavailable".
ANTHROPIC_API_KEY=

# Brand logos, free at https://developers.brandfetch.com
BRANDFETCH_CLIENT_ID=

# Image storage. Without BUCKET files go to ./storage (development only).
# Railway buckets and other S3-compatible storage:
BUCKET=
ENDPOINT=
REGION=auto
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=

# Protects /api/internal/jobs/* (Railway cron sends it as X-Job-Secret). Required in production.
JOB_SECRET=

# Dev sign-in (POST /api/v1/auth/dev) is on outside production unless set to "false"
ALLOW_DEV_LOGIN=true
